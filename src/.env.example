# Copy to `src/.env` and fill in real values. `src/.env` is gitignored.
#
# Nothing here is loaded automatically. `core/config.py` deliberately does NOT
# call load_dotenv() at import time — importing a module must never repopulate
# credentials into the process (a plain `unittest discover` imports every test
# file, including live-gated ones, and would otherwise defeat the
# skipUnless(os.environ.get(...)) guards and risk a real billed call).
#
# Load it explicitly instead:
#     set -a && source src/.env && set +a
#     PYTHONPATH=src .venv/bin/python src/chat/interactive_chat.py
#
# Without this, the OpenAI SDK raises a misleading
# "Missing credentials ... set the OPENAI_API_KEY environment variable" even
# though the configured provider is not OpenAI.

# --- LLM provider -----------------------------------------------------------
# Any OpenAI-compatible endpoint works; change these three to switch provider.
# Defaults live in core/config.py (Groq + qwen3.6-27b) and are used when unset.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.6-27b
LLM_API_KEY=<your-api-key>

# Provider-specific key names are also accepted as fallbacks, in this order:
#   LLM_API_KEY -> GROQ_API_KEY -> FIREWORKS_API_KEY
# GROQ_API_KEY=<your-groq-key>
# FIREWORKS_API_KEY=<your-fireworks-key>

# Hidden reasoning is sent only when this is non-empty. Valid values are
# model-specific and a wrong one is a hard HTTP 400:
#   qwen3.6   -> none | default
#   gpt-oss   -> low | medium | high   (cannot be turned off)
# Leave empty for providers/models that don't know the parameter at all.
# `none` is the default: measured 0.17s vs 0.50-0.76s per extraction call, and
# it fixes correctness too — with reasoning on, qwen returns HTTP 400
# "Failed to validate JSON" because reasoning text corrupts the JSON body.
LLM_REASONING_EFFORT=none

# The OpenAI SDK defaults this to 2, which silently multiplies every timeout
# (a 45s cap produced a measured 163947ms call). Kept at 1 rather than 0 so a
# 429 still gets one retry.
# LLM_SDK_MAX_RETRIES=1

# --- Storage / transport ----------------------------------------------------
# Must match the token the hydradb container actually starts with; compose.yaml's
# entrypoint writes this value to /tmp/graph/auth-token. A mismatch surfaces as
# `HydraDB returned HTTP 401: valid bearer authentication is required`.
CONTEXT_MEMORY_HYDRADB_TOKEN=context-memory-local-smoke-token-32b
# CONTEXT_MEMORY_HYDRADB_URL=http://127.0.0.1:8080
# CONTEXT_MEMORY_DATABASE_URL=postgresql://context_memory@127.0.0.1:54329/context_memory

# --- Optional tuning --------------------------------------------------------
# Every field on core/config.py's Config is env-overridable; these are the ones
# most worth reaching for. See that file for the full list and the reasoning
# behind each default.
# EXTRACTOR_MAX_TOKENS=4096
# EXTRACTOR_TIMEOUT_SECONDS=45
# READER_TEMPERATURE=0.2
# RETRIEVAL_TOP_K=15
# RETRIEVAL_ABSTENTION_SEMANTIC_THRESHOLD=0.3
